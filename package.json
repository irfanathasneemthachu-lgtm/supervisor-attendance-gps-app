{
  "name": "supervisor-attendance-gps-app",
  "version": "1.0.0",
  "description": "Professional Supervisor Attendance & GPS Verification App",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "node server/scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-cors": "^0.0.7",
    "dotenv": "^16.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "axios": "^1.3.4",
    "date-fns": "^2.29.3",
    "geolib": "^3.3.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^8.0.1"
  }
}
